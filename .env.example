# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
# Telegram ID админов через запятую (свой ID можно узнать у @userinfobot)
ADMIN_IDS=123456789

# polling (по умолчанию) или webhook
BOT_MODE=polling
# Публичный HTTPS-адрес сервера — нужен для вебхуков
PUBLIC_URL=https://example.com
BOT_WEBHOOK_SECRET=

# --- Магазин ---
CURRENCY=RUB
CURRENCY_SYMBOL=₽
MIN_TOPUP=100
MAX_TOPUP=100000
DB_PATH=data/shop.db
PORT=3000

# --- Оплата криптой через @CryptoBot (Crypto Pay API) ---
# Токен: @CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_API_URL=https://pay.crypt.bot/api
# Чем разрешено платить (пусто = все активы приложения)
CRYPTO_PAY_ASSETS=USDT,TON,BTC
CRYPTO_PAY_TTL=3600

# --- Ручной криптоперевод (подтверждает админ) ---
MANUAL_CRYPTO=0
# Формат: Название=Адрес; Название=Адрес
MANUAL_CRYPTO_WALLETS=USDT TRC-20=TXXXXXXXXXXXXXXXXXXXX;TON=UQXXXXXXXXXXXXXXXX
